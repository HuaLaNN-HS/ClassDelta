<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:controls1="clr-namespace:ClassIsland.Controls"
             xmlns:views="clr-namespace:ClassIsland.Views"
			 xmlns:loc="clr-namespace:ClassIsland.Services"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.WelcomePages.WelcomePage">
    <UserControl.Styles>
        <Style Selector="Grid#ContentRoot.anim">
            <Style.Animations>
                <Animation Duration="0:0:0.2"
                           FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid >
        <Grid x:Name="ContentRoot" Opacity="0.0"
              RowDefinitions="*, Auto, *">
            <Image Grid.Row="0" VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 8"
                   Source="/Assets/AppLogo.png"
                   Height="80" Width="80"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        x:Name="TextsMain"
                        Opacity="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        TextElement.FontSize="32">
                <StackPanel.Styles>
                    <Style Selector="StackPanel" >
                        <Style Selector="^ TextBlock">
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </Style>
                </StackPanel.Styles>
                <TextBlock Text="H" />
                <TextBlock Text="e" />
                <TextBlock Text="l" />
                <TextBlock Text="l" />
                <TextBlock Text="o" />
                <TextBlock Text=" " />
                <TextBlock Text="W" />
                <TextBlock Text="o" />
                <TextBlock Text="r" />
                <TextBlock Text="l" />
                <TextBlock Text="d" />
            </StackPanel>

			<StackPanel Grid.Row="2"
            Spacing="10"
            VerticalAlignment="Top"
            HorizontalAlignment="Center">
				<TextBlock
					Text="Please choose your language&#10;请选择语言"
					TextAlignment="Center"
					HorizontalAlignment="Center"
					TextWrapping="Wrap"
					Margin="0,8,0,0"/>
				<ComboBox
					x:Name="LanguageSelector"
					Width="240"
					HorizontalAlignment="Center"
					ItemsSource="{x:Static loc:UiLocalizationService.SupportedLanguages}"
					SelectedValue="{Binding ViewModel.SettingsService.Settings.UiLanguage, Mode=TwoWay}"
					SelectedValueBinding="{Binding Code}">

					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button
					HorizontalAlignment="Center"
					Content="{ci:FluentIcon &#xE130;, FontSize=18}"
					Width="48"
					Height="48"
					CornerRadius="24"
					Classes="accent"
					ToolTip.Tip="Next/下一步"
					IsEnabled="True"
					Click="ButtonNext_OnClick"
					Margin="0,4,0,0"/>
			</StackPanel>
            
            <StackPanel Grid.Row="2"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="8"
                        Spacing="2">
                <TextBlock Text="{x:Static ci:AppBase.AppVersion}" HorizontalAlignment="Center"
                           Opacity="0.75"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <StackPanel.Styles>
                        <Style Selector="HyperlinkButton">
                            <Setter Property="Padding" Value="4"/>
                        </Style>
                    </StackPanel.Styles>
                    <HyperlinkButton Click="ButtonDataMigration_OnClick">
                        <TextBlock>Data Transfer</TextBlock>
                    </HyperlinkButton>
                    <HyperlinkButton Click="ButtonEnterRecovery_OnClick">
                        <TextBlock>Resolve Bugs/Restore a Backup</TextBlock>
                    </HyperlinkButton>
                    <HyperlinkButton Click="ButtonJoinManagement_OnClick">
                        <TextBlock>Join a Management Group</TextBlock>
                    </HyperlinkButton> 
                </StackPanel>
            </StackPanel>
        </Grid>
        
        <!-- Intro -->
        <controls1:OobeIntroAnimationControl x:Name="Intro"
                                             AnimationEnd="Intro_OnAnimationEnd"/>
        
        
    </Grid>
</UserControl>
