<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:welcomePages="clr-namespace:ClassIsland.Views.WelcomePages"
             xmlns:views="clr-namespace:ClassIsland.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.WelcomePages.SystemPage">
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Padding" Value="8 0"/>
        </Style>
    </UserControl.Styles>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Classes="settings-container animated-intro"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=welcomePages:SystemPage}}"
                MaxWidth="600">
        <TextBlock Text="System" HorizontalAlignment="Center"
                   Margin="0 0 0 4"
                   Theme="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock Text="Set up System-Integrated features for CIIEC, which can improve your experience of using this software." HorizontalAlignment="Center"
                   Margin="0 0 0 8"/>
        
        <CheckBox IsChecked="{Binding ViewModel.CreateStartupShortcut}">
            <CheckBox.IsVisible>
                <OnPlatform Default="True">
                    <On Options="macOS" Content="False"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE342;}" Header="Start on boot"
                      Description="Run this software on boot of your system." />
        </CheckBox>
        <!--<CheckBox>
            <controls:SettingsControl HasSwitcher="False"
                                      IconGlyph="Link" Header="文件关联"
                                      Description="注册*.cip文件格式关联，便于导入档案文件。" />
        </CheckBox>-->
        <CheckBox IsChecked="{Binding ViewModel.CreateDesktopShortcut}">
            <CheckBox.IsVisible>
                <OnPlatform Default="True">
                    <On Options="macOS" Content="False"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE62F;}" Header="Create shortcut on desktop"
                      Description="Create a shortcut on your desktop." />
        </CheckBox>
        <CheckBox IsChecked="{Binding ViewModel.CreateStartMenuShortcut}">
            <CheckBox.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Converter="{x:Static ObjectConverters.NotEqual}" Source="{x:Static ci:AppBase.Current}"
                             Path="PackagingType" ConverterParameter="deb"/>
                    <Binding Converter="{x:Static ObjectConverters.NotEqual}" Source="{x:Static ci:AppBase.Current}"
                             Path="OperatingSystem" ConverterParameter="macos"/>
                </MultiBinding>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE064;}"
                      Header="Create a shortcut on the start menu"
                      Description="Creates a shortcut for this software on your start menu." />
        </CheckBox>
        <CheckBox IsChecked="{Binding ViewModel.RegisterUrlScheme}">
            <CheckBox.IsVisible>
                <OnPlatform Default="False">
                    <On Options="Windows" Content="True"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xEAB0;}"
                      Header="Register a URL protocol (Highly Recommended)"
                      Description="Allows third party software or webpages to use some features of this software through URL protocol classisland://, you can learn more at our docs." />
        </CheckBox>
        <CheckBox Margin="22 0 0 0"
                  IsChecked="{Binding ViewModel.CreateClassSwapShortcut}"
                  IsEnabled="{Binding ViewModel.RegisterUrlScheme}">
            <CheckBox.IsVisible>
                <OnPlatform Default="False">
                    <On Options="Windows" Content="True"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE15F;}"
                      Header="Create a shortcut for swap lessons on your desktop"
                      Description="Run the shortcut to swap lessons in one click." />
        </CheckBox>
        
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <Button Command="{x:Static views:WelcomeWindow.WelcomeNavigateBackCommand}"
                    ToolTip.Tip="Previous"
                    Content="{ci:FluentIcon &#xE108;, FontSize=18}"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Margin="0 8 0 0"/>
            <Button Command="{x:Static views:WelcomeWindow.WelcomeNavigateForwardCommand}"
                    ToolTip.Tip="下一步"
                    Content="{ci:FluentIcon &#xE130;, FontSize=18}"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Classes="accent" 
                    Margin="0 8 0 0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
